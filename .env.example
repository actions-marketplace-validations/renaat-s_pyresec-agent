# ==================== PYRESEC Environment Variables ====================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Coinbase AgentKit Wallet ---
CDP_WALLET_SECRET=

# --- LLM Provider ---
GROQ_API_KEY=

# --- Network ---
NETWORK_ID=base-mainnet
PRODUCTION_URL=https://pyresec-agent-519576377065.us-central1.run.app

# --- Dev Wallet (receives profit splits) ---
DEV_WALLET_ADDRESS=

# --- Population Control ---
MAX_ACTIVE_AGENTS=5

# --- Spending Limits ---
MONTHLY_SPENDING_LIMIT=50.00
DAILY_TRANSFER_LIMIT=10.00
MAX_SINGLE_TRANSFER=5.00

# --- Admin ---
ADMIN_KEY=changeme

# --- Server ---
HOST=0.0.0.0
PORT=8080

# --- Git Scraper (scripts/git_scraper.py) ---
GITHUB_TOKEN=
RESEND_API_KEY=
PYRESEC_SENDER=pyresec@nanoclonesystems.com
PYRESEC_FROM_NAME=PYRESEC Agent

# --- Social Scanner (scripts/social_scanner.py) ---
# TWITTER_BEARER_TOKEN=      # X API v2 bearer token (get at developer.x.com)
# NEYNAR_API_KEY=            # Farcaster API via Neynar (free key at neynar.com)
# PROMO_WALLET_KEY=          # key of NON-dev wallet that pays x402 for sponsored scans
#                            # (must differ from DEV_WALLET_ADDRESS — payTo rejects self-sends)

# --- Auto-posting (Telegram approval queue) ---
# TELEGRAM_BOT_TOKEN=        # bot token from @BotFather
# TELEGRAM_CHAT_ID=          # your chat ID (auto-detected on first run)
# FARCASTER_MNEMONIC=        # Farcaster recovery phrase (one-time signer setup)
# FARCASTER_SIGNER_UUID=     # set automatically by farcaster_signer.py
# MAX_LEADS_PER_CYCLE=5      # max leads sent to Telegram per poll cycle
